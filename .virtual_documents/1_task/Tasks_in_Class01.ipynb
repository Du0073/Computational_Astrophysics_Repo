def my_ieee754(x):
    #sign bit
    sign = "1" if x < 0 else "0"
    x = abs(x)
    
    #integer and fraction parts
    integer = int(x)
    frac = x - integer
    bin_integer = entero_a_binario(integer)
    bin_frac = fraccion_a_binario(frac)
    
    #mantissa and exponent analysis
    if integer > 0:
        exp_true = len(bin_integer)-1
        mantissa_raw = bin_integer[1:] + bin_frac
    else:
        first_one = bin_frac.find(1)
        if first_one == -1: return "0"*32
        exp_true = -(first_one+1)
        mantissa_raw = bin_frac[first_one+1:]
    
    #8 bits exponent - 127 bias
    exp = exp_true + 127
    bin_exp = entero_a_binario(exp).zfill(8)

    #23 bits mantissa and round the number 
    mantissa = mantissa_raw[:23]
    if len(mantissa_raw) > 23 and mantissa_raw[23]=='1':
        mantissa_int = int(mantissa,2) + 1
        mantissa = bin(mantissa_int)[2:].zfill(23)
    else:
        mantissa = mantissa.ljust(23,'0')

    return f"{sign} {bin_exp} {mantissa}"





