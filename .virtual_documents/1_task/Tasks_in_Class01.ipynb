import math

print(" ----------------- a) -----------------")
def e_maclaurin(x,n):
    summation = 0
    for i in range(n):
        summation += (x**i)/math.factorial(i)
    return summation

x = 0.5
terms = 4
e_approx = e_maclaurin(x,terms)

print("Valor aproximado de e ^ ",x,"con",terms,"terminos =",e_approx)

print(" ----------------- b) -----------------")
e_real = math.exp(x)
print("Valor real de e ^ ",x,"=",e_real)

